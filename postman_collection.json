        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/books?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "books"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            },
            "description": "Get paginated list of all books"
          }
        },
        {
          "name": "Get Books - Filter by Category",
          "request": {
            "method": "GET",
