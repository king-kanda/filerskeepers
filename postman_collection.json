          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/books?sort_by=-price&page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "books"],
              "query": [
                {
                  "key": "sort_by",
                  "value": "-price"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            },
            "description": "Get books sorted by price (highest first)"
          }
        },
        {
          "name": "Get Books - Sort by Reviews",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/books?sort_by=-reviews&page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "books"],
              "query": [
                {
                  "key": "sort_by",
                  "value": "-reviews"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            },
            "description": "Get books sorted by review count (highest first)"
