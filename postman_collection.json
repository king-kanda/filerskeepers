        {
          "name": "Get Books - Combined Filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/books?category=Fiction&min_price=20&max_price=60&rating=Four&sort_by=-price&page=1&page_size=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "books"],
              "query": [
                {
                  "key": "category",
                  "value": "Fiction"
                },
                {
                  "key": "min_price",
                  "value": "20"
                },
                {
                  "key": "max_price",
                  "value": "60"
                },
                {
                  "key": "rating",
                  "value": "Four"
                },
                {
                  "key": "sort_by",
                  "value": "-price"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "10"
                }
              ]
            },
            "description": "Get books with multiple filters applied"
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/books/{{book_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "books", "{{book_id}}"]
            },
            "description": "Get a specific book by its ID"
          }
        }
      ]
    },
